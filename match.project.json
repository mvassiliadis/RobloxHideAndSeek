{
  "name": "Hide & Seek - Match",
  "servePlaceIds": [88216950471180],
  "placeId": 88216950471180,
  "gameId": 10628256098,
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true
    },

    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Packages": {
        "$path": "Packages"
      },
      "RoundState": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,
        "$properties": {
          "Attributes": {
            "Phase": { "String": "WaitingToStart" },
            "TimeRemaining": { "Float64": 0 },
            "StartTimeRemaining": { "Float64": 0 },
            "ConnectedPlayers": { "Float64": 0 },
            "RoleSelectionDuration": { "Float64": 5 },
            "RoleSelectionEndTime": { "Float64": 0 },
            "SelectionUserIds": { "String": "" },
            "SelectedSeekerUserId": { "Float64": 0 },
            "TaggedHiderUserId": { "Float64": 0 },
            "TaggedHiderName": { "String": "" },
            "StudioPracticeEnabled": { "Bool": true },
            "StudioPracticeHiderCount": { "Float64": 2 },
            "StudioPracticeHidingDuration": { "Float64": 3 },
            "PracticeModeActive": { "Bool": false },
            "RoundNumber": { "Float64": 0 },
            "HidingDuration": { "Float64": 30 }
          }
        },
        "ResetRequested": {
          "$className": "RemoteEvent"
        },

        "TagRequested": {
          "$className": "RemoteEvent"
        },

        "ReturnToLobbyRequested": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "RoundController": {
        "$path": "src/match/ServerScriptService/RoundController.server.luau"
      },
      "ReturnToLobby": {
        "$path": "src/match/ServerScriptService/ReturnToLobby.server.luau"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "CameraMode": "LockFirstPerson"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "RoundGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": false,
        "$properties": {
          "DisplayOrder": 10,
          "ResetOnSpawn": false,
          "ZIndexBehavior": "Sibling"
        },
        "ReactRoot": {
          "$className": "Frame",
          "$ignoreUnknownInstances": true,
          "$properties": {
            "BackgroundTransparency": 1,
            "BorderSizePixel": 0,
            "Size": { "UDim2": [[1, 0], [1, 0]] }
          }
        },
        "RoundApp": {
          "$path": "src/match/StarterGui/RoundApp.luau"
        },
        "RoundUI": {
          "$path": "src/match/StarterGui/RoundUI.client.luau"
        }
      }
    }
  }
}
